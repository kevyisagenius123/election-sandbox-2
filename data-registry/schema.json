{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sandbox-2.local/schemas/source-registry-entry.json",
  "title": "Sandbox 2.0 source registry entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "publisher",
    "title",
    "sourceUrl",
    "retrievedAt",
    "electionId",
    "licenseStatus",
    "checksumSha256",
    "pipelineVersion",
    "limitations"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "sourceUrl": { "type": "string", "format": "uri" },
    "retrievedAt": { "type": "string", "format": "date-time" },
    "electionId": { "type": "string", "minLength": 1 },
    "geographyVintage": { "type": ["string", "null"] },
    "licenseStatus": {
      "enum": ["verified", "review_required", "restricted"]
    },
    "checksumSha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "pipelineVersion": { "type": "string", "minLength": 1 },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
